# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
DATABASE_URL=postgresql+psycopg://leadforge:leadforge@localhost:5432/leadforge
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# Lead discovery and enrichment
APIFY_API_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places
APIFY_WEB_ACTOR_ID=apify/website-content-crawler
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
LEAD_FETCH_TIMEOUT_SECONDS=20
LEAD_MAX_WEBSITE_PAGES=5
DEFAULT_LEAD_LIMIT=50
ENABLE_SCREENSHOT_CAPTURE=true

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=LeadForgeLeads
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Railway/Netlify/Docker cloud alternative. Paste the full one-line service account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_REPLY_SYNC_INTERVAL_SECONDS=60
AUTO_REPLY_ENABLED=true
AUTO_REPLY_BODY="Hi,\n\nThanks for getting back to me. I received your reply and will close this outreach on my side.\n\nBest,"
