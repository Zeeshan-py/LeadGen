# Docker Compose
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_URL=http://localhost:8000
APP_PORT=8000
IMAGE_TAG=latest
# Leave empty for the combined FastAPI + exported frontend container.
# Set to the public backend URL only when hosting the frontend separately.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=https://leadforage.pro
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SP7RR0FXH3
NEXT_PUBLIC_GTM_ID=

# Backend
# Used when running the backend outside Docker Compose.
DATABASE_URL=postgresql+psycopg://leadgen:replace-with-a-long-random-password@localhost:5432/leadgen
FRONTEND_ORIGIN=http://localhost:8000
PUBLIC_URL=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
FORWARDED_ALLOW_IPS=127.0.0.1

# Paddle Billing
# Use sandbox credentials until you are ready to switch to live billing.
PADDLE_ENV=sandbox
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_LIVE_API_KEY=
PADDLE_LIVE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
PADDLE_SUCCESS_URL=https://leadforage.pro/billing/success
PADDLE_CANCEL_URL=https://leadforage.pro/billing/cancel
PADDLE_BASIC_PRODUCT_ID=pro_01kys3ejdgd3nr6y6j2cqcrjcg
PADDLE_BASIC_PRICE_ID=pri_01kys3qbxn3wzm9qj531997ksz
PADDLE_AGENT_PRODUCT_ID=pro_01kys3xzth1mn7gwrq6k0rd0p8
PADDLE_AGENT_PRICE_ID=pri_01kys40md1hjtvpyztme23cnmx
PADDLE_AGENCY_PRODUCT_ID=pro_01kys41tnxknbjg790vp2n0j0a
PADDLE_AGENCY_PRICE_ID=pri_01kys43pt84j6b43stbp0wfd2z

# Authentication
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=leadforge
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SESSION_REFRESH_TOKEN_DAYS=1
PASSWORD_RESET_TOKEN_MINUTES=30
# Use false for local HTTP Docker Compose. Use true when deployed behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
ADMIN_EMAIL=support@leadforage.pro
ADMIN_PASSWORD=replace-with-the-admin-password

# OAuth login (separate from Gmail Email Outreach)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Optional compatibility aliases for Google login. Prefer GOOGLE_OAUTH_* above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# Signup email abuse protection
ABSTRACT_EMAIL_API_KEY=
ABSTRACT_EMAIL_REPUTATION_URL=https://emailreputation.abstractapi.com/v1
ABSTRACT_EMAIL_TIMEOUT_SECONDS=6
ABSTRACT_EMAIL_CACHE_HOURS=24
DISPOSABLE_EMAIL_BLOCKLIST_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/master/disposable_email_blocklist.conf
DISPOSABLE_EMAIL_CACHE_PATH=./storage/disposable_email_domains.txt
DISPOSABLE_EMAIL_FETCH_TIMEOUT_SECONDS=10

# Lead discovery and enrichment
APIFY_API_TOKEN=
APIFY_ACTOR_ID=compass/crawler-google-places
APIFY_WEB_ACTOR_ID=apify/website-content-crawler
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
LEAD_FETCH_TIMEOUT_SECONDS=20
LEAD_MAX_WEBSITE_PAGES=5
DEFAULT_LEAD_LIMIT=50
ENABLE_SCREENSHOT_CAPTURE=true
SCREENSHOTS_DIR=./storage/screenshots

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=LeadForgeLeads
# Required to enable Google Sheets. Paste the complete service account JSON as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gmail OAuth for per-user Email Outreach only; do not reuse these for Google login.
# Add this authorized redirect URI to the Gmail OAuth client:
# http://localhost:8000/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Legacy global sender credentials are no longer used for sending.
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=
GMAIL_REPLY_SYNC_INTERVAL_SECONDS=60
AUTO_REPLY_ENABLED=true
AUTO_REPLY_BODY="Hi,\n\nThanks for getting back to me. I received your reply and will close this outreach on my side.\n\nBest,"

# AI SDR
AI_SDR_ENABLED=true
AI_SDR_API_PREFIX=/ai-sdr
AI_SDR_DEFAULT_ACTOR=LeadForge AI SDR
AI_SDR_MAX_CONTACTS_PER_IMPORT=1000
AI_SDR_STORE_RAW_PAYLOADS=true
AI_SDR_DEFAULT_CRM_STAGE=new

# AI SDR Calling
AI_SDR_CALLING_ENABLED=true
AI_SDR_CALLING_MODE=production
AI_SDR_PUBLIC_WEBSOCKET_URL=
AI_SDR_TELEPHONY_PROVIDER=twilio
AI_SDR_LLM_PROVIDER=gemini
AI_SDR_SPEECH_PROVIDER=cartesia
AI_SDR_CALL_FROM_NUMBER=
AI_SDR_CALL_DEFAULT_OBJECTIVE="Qualify the business need, identify website or follow-up gaps, and book the best next step."
AI_SDR_CALL_SILENCE_TIMEOUT_SECONDS=1.2
AI_SDR_CALL_MAX_DURATION_SECONDS=1800
# Legacy/dev fallback only. Signed-in users connect their own Twilio account in Settings -> Voice.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
AI_SDR_GEMINI_MODEL=gemini-2.5-flash
# Legacy/dev fallback only. Signed-in users can store their own Cartesia key and voice settings.
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-03-01
CARTESIA_TTS_MODEL=sonic-3.5
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_VOICE_ID=
CARTESIA_LANGUAGE=en
CARTESIA_TTS_SPEED=normal
CARTESIA_TTS_SAMPLE_RATE=8000
CARTESIA_TTS_ENCODING=pcm_mulaw
CARTESIA_STT_SAMPLE_RATE=8000
CARTESIA_STT_ENCODING=pcm_mulaw
CARTESIA_STT_WS_URL=wss://api.cartesia.ai/stt/websocket
AI_SDR_ASSISTANT_NAME=
AI_SDR_ASSISTANT_BUSINESS_NAME=
AI_SDR_AI_GREETING=
